# Copy to .env and fill in real values. Never commit the actual .env file.

# development | production — controls stack-trace exposure, CORS strictness,
# and the production startup warnings in utils/validateEnv.js.
NODE_ENV=development

PORT=5000

# MongoDB connection string.
# Local dev:  mongodb://localhost:27017/nine-secrets
# Atlas prod: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nine-secrets?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/nine-secrets

# Long random secrets — e.g. `openssl rand -hex 32`. Never reuse across environments.
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API in production.
# e.g. https://ninesecrets.com,https://www.ninesecrets.com
# Left empty, CORS allows every origin — fine for local dev only.
ALLOWED_ORIGINS=

# Public URL of the storefront — used in password-reset email links.
FRONTEND_URL=http://localhost:5173

# Cloudinary — required in production for image uploads to persist across
# deploys/instances. Without these, uploads fall back to local disk (dev-only).
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP — required in production to actually send order-confirmation and
# password-reset emails. Without SMTP_HOST, they're only logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nine Secrets <no-reply@ninesecrets.com>"

# Used once by scripts/seed.js to create the first superadmin account.
# If left unset, seed.js generates a random one and prints it once.
SEED_ADMIN_PASSWORD=

# Google AI Studio API key — powers the admin "Generate with AI" product
# description button (Gemini Flash-Lite reads the product photo and drafts a
# description). Optional — without it, that one button just won't work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Razorpay — required for the "Card / UPI" checkout option. Create a Razorpay
# account, grab the Key ID + Key Secret from Settings → API Keys, and set the
# SAME Key ID as VITE_RAZORPAY_KEY_ID in frontend/.env (it's the public half —
# safe to expose client-side; the Key Secret here never leaves the server).
# Without these, checkout only offers Cash on Delivery.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Hours a non-empty cart must sit untouched before an abandoned-cart reminder
# email is sent (see jobs/abandonedCart.js). Optional — defaults to 2.
ABANDONED_CART_HOURS=2
