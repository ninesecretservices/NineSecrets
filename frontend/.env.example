# Copy to .env (local dev) or .env.production (production build) and fill in.
# Vite only exposes vars prefixed VITE_ to client code — see src/utils/api.js.

# Base URL of the backend API, including the /api prefix.
# Local dev:  http://localhost:5000/api  (this is the default if unset)
# Production: https://api.ninesecrets.com/api
VITE_API_URL=http://localhost:5000/api

# Razorpay Key ID (the public half of the pair — safe to expose client-side).
# Must match backend RAZORPAY_KEY_ID exactly. Without it, checkout only offers
# Cash on Delivery — the "Card / UPI" option stays disabled.
VITE_RAZORPAY_KEY_ID=

# Google Analytics 4 measurement ID and/or Meta Pixel ID. Both optional and
# independent — each only loads if set, and only after the shopper accepts
# the cookie-consent banner (see src/utils/analytics.js).
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
