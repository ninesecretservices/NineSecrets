# Copy to .env (local dev) or .env.production (production build) and fill in.
# Vite only exposes vars prefixed VITE_ to client code — see src/utils/api.js.

# Base URL of the backend API, including the /api prefix.
# Local dev:  http://localhost:5000/api  (this is the default if unset)
# Production: https://api.ninesecrets.com/api
VITE_API_URL=http://localhost:5000/api
